# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요. (.env는 커밋 금지)
# 키 발급: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-여기에_키_입력

# Supabase 대시보드 → Connect → Transaction pooler(포트 6543) 연결 문자열. 비우면 로컬 SQLite(data/app.db)에 저장합니다.
# DATABASE_URL=postgresql://postgres.<프로젝트ID>:<DB비밀번호>@aws-0-<지역>.pooler.supabase.com:6543/postgres
