# 구글 로그인 설정 예시입니다. 이 파일을 .streamlit/secrets.toml로 복사한 뒤 실제 값을 넣으세요.
# .streamlit/secrets.toml은 .gitignore에 들어 있어 깃허브에 올라가지 않습니다.
# 배포 앱(Streamlit Community Cloud)의 Secrets에는 최상위 키를 먼저 쓰고 [auth]를 맨 뒤에 두며,
# redirect_uri만 https://<앱이름>.streamlit.app/oauth2callback 으로 바꿉니다.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "python -c \"import secrets; print(secrets.token_hex(32))\" 로 만든 값"
client_id = "구글_OAuth_클라이언트_ID"
client_secret = "구글_OAuth_클라이언트_보안_비밀"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
